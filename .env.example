# Copy to .env, fill in what you need, then run:  npm run dev:env
# (On a host such as Cloudflare or Lovable, add these as secrets/environment variables instead.)

# --- Required in production ---
SESSION_SECRET=            # any long random string (32+ chars). Signs login cookies, encrypts plugin tokens.
APP_URL=http://localhost:5173   # public URL of the app (used for OAuth redirect URLs)

# --- Your AI model (any OpenAI-compatible /chat/completions endpoint, e.g. StickAPI) ---
STICK_API_URL=             # e.g. https://api.yourdomain.com/v1
STICK_API_KEY=
# STICK_MODEL_MAP={"stick-2":"your-real-model-name"}   # optional: rename models upstream
# Images (optional): defaults to STICK_API_URL / STICK_API_KEY
# STICK_IMAGE_URL=
# STICK_IMAGE_KEY=
# STICK_IMAGE_MODEL=stick-image
# Gemini images ("Nano Banana"): uses Google's native API, not /images/generations
# STICK_IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=            # key from aistudio.google.com/apikey (or reuse STICK_API_KEY)
# STICK_IMAGE_MODEL=gemini-3.1-flash-image-preview   # check AI Studio for current names

# --- Saving accounts, chats and plugin connections (free tier at upstash.com) ---
# Without these, data is kept in server memory and lost on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Plugins that connect to real accounts ---
GOOGLE_CLIENT_ID=          # Gmail, Google Calendar, Google Drive
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Search engines: how Google shows "StickAI / Made by Stick" ---
# Set before building. Your real public address, no trailing slash:
# VITE_SITE_URL=https://your-real-site-address
# VITE_GOOGLE_SITE_VERIFICATION=   # code from Google Search Console (HTML tag method)

# --- Sign-in ---
# Chat and images need an account by default. To let guests chat (local testing only):
# STICK_ALLOW_GUESTS=true
# Messages per person per hour (default 60). Protects your Gemini bill:
# STICK_CHAT_LIMIT_PER_HOUR=60

# --- Sign in with Google / Apple (buttons appear automatically when configured) ---
# Google uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above. Add this redirect URL in Google Cloud Console too:
#   {APP_URL}/api/auth/google/callback
# Apple needs a paid Apple Developer account and an https address (no localhost):
# APPLE_CLIENT_ID=      # your Services ID, e.g. com.stick.stickai.web
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=    # contents of the .p8 file; write line breaks as \n
