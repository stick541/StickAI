# StickAI settings. Paste your Gemini key on the STICK_API_KEY line, then run: npm run dev:env

# One Gemini key for chat AND images
STICK_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
STICK_API_KEY=PASTE-YOUR-GEMINI-KEY-HERE

# Every Stick model runs on Gemini 2.5 Pro
STICK_MODEL_MAP={"stick":"gemini-2.5-pro","stick-1":"gemini-2.5-pro","stick-1-1":"gemini-2.5-pro","stick-2":"gemini-2.5-pro","stick-2-1":"gemini-2.5-pro","stick-build":"gemini-2.5-pro"}

# Images (uses the same key)
STICK_IMAGE_PROVIDER=gemini
STICK_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Needed before you put the app online (not for running on your computer)
# SESSION_SECRET=any-long-random-string-32-characters-or-more
# APP_URL=https://your-real-site-address

# Optional: save accounts, chats and plugin connections (free at upstash.com)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: real Gmail, Calendar, Drive and Slack plugins
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Search engines (set BEFORE building for the web). Your real public address, no trailing slash:
# VITE_SITE_URL=https://your-real-site-address
# VITE_GOOGLE_SITE_VERIFICATION=   # code from Google Search Console (HTML tag method)

# Let people chat without an account (for testing on your own computer only):
# STICK_ALLOW_GUESTS=true
# Messages per person per hour (default 60). Protects your Gemini bill:
# STICK_CHAT_LIMIT_PER_HOUR=60

# Sign in with Google (same client id/secret as the Google plugins; also add the redirect URL
#   {APP_URL}/api/auth/google/callback  in Google Cloud Console):
# (uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above)
# Sign in with Apple (needs a paid Apple Developer account; Apple only works on https, not localhost):
# APPLE_CLIENT_ID=      # your Services ID, e.g. com.stick.stickai.web
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=    # contents of the .p8 file; write line breaks as \n
